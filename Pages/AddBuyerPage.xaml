<Page x:Class="Pharmacy.Pages.AddBuyerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pharmacy.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddBuyerPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>

        </Grid.ColumnDefinitions>
        <StackPanel>
            <StackPanel>

                <Label>Фио</Label>
                <TextBox x:Name="t">
                    <Binding Path="_group.Name"  UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>

                        </Binding.ValidationRules>
                    </Binding>
                </TextBox>
                <Label>Дата рождения</Label>
                <DatePicker x:Name="t11">
                    <DatePicker.SelectedDate>
                        <Binding Path="_group.Date">
                            <Binding.ValidationRules>

                            </Binding.ValidationRules>
                        </Binding>

                    </DatePicker.SelectedDate>
                </DatePicker>
                <Label>Телефон</Label>
                <TextBox x:Name="t111">
                    <Binding Path="_group.Phone"  UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>

                        </Binding.ValidationRules>
                    </Binding>
                </TextBox>
                <Label>Почта</Label>
                <TextBox x:Name="t1112">
                    <Binding Path="_group.Email"  UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>

                        </Binding.ValidationRules>
                    </Binding>
                </TextBox>
            </StackPanel>
            <StackPanel>
                <Button Click="Button_Click">Сохранить</Button>
                <Button Click="Button_Click_1">Назад</Button>
            </StackPanel>
        </StackPanel>

    </Grid>
</Page>
