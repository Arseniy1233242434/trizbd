<Page x:Class="Pharmacy.Pages.BuyerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pharmacy.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BuyerPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="200"></ColumnDefinition>

        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1">
            <Button Margin="7" Height="25" Click="Button_Click">
                Добавить
            </Button>
            <Button Margin="7" Height="25" Click="Button_Click_1">
                Удалить
            </Button>

        </StackPanel>
        <ListView 
                  
ItemsSource="{Binding service.Users}"

SelectedItem="{Binding current}" MouseDoubleClick="ListView_MouseDoubleClick_1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>


                        <TextBlock>
<Run Text="ФИО: "/>
<Run Text="{Binding Name}"/>

                        </TextBlock>
                        <TextBlock>
<Run Text="Дата рождения: "/>
<Run Text="{Binding Date}"/>

                        </TextBlock>
                        <TextBlock>
<Run Text="Телефон: "/>
<Run Text="{Binding Phone}"/>

                        </TextBlock>
                        <TextBlock>
<Run Text="Почта: "/>
<Run Text="{Binding Email}"/>

                        </TextBlock>


                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
