<Page x:Class="Pharmacy.Pages.AddArrivalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pharmacy.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddArrivalPage" >
    <Page.Resources>
       
    </Page.Resources>
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>

        </Grid.ColumnDefinitions>
        <StackPanel >
            <StackPanel>

                
                <Label>Препарат</Label>
                <ComboBox 
                          DisplayMemberPath="Name" 
SelectedItem="{Binding _group.Medicine}" ItemsSource="{Binding service1.Users}"/>
                <Label></Label>
                <Label>Постащик</Label>
                <ComboBox 
                          DisplayMemberPath="Name" 
SelectedItem="{Binding _group.Supplier}" ItemsSource="{Binding service2.Users}"/>

                <Label>Кол-во</Label>
                <TextBox x:Name="t">
                    <Binding Path="_group.OrderNumber"  UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>

                        </Binding.ValidationRules>
                    </Binding>
                </TextBox>
                <Label>Дата</Label>
                <DatePicker x:Name="t11">
                    <DatePicker.SelectedDate>
                        <Binding Path="_group.Date">
                            <Binding.ValidationRules>

                            </Binding.ValidationRules>
                        </Binding>

                    </DatePicker.SelectedDate>
                </DatePicker>
                <Label></Label>
                

                <Label>Цена поставки</Label>
                <TextBox x:Name="tjh">
                    <Binding Path="_group.Price"  UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>

                        </Binding.ValidationRules>
                    </Binding>
                </TextBox>
                <Label>Цена за упаковку</Label>
                <TextBox x:Name="tfgfgfg">
                    <Binding Path="_group.PricePackage"  UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>

                        </Binding.ValidationRules>
                    </Binding>
                </TextBox>
            </StackPanel>
            <StackPanel>
                <Button Click="Button_Click">Сохранить</Button>
                <Button Click="Button_Click_1">Назад</Button>
            </StackPanel>
        </StackPanel>

    </Grid>
</Page>
