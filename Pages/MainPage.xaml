<Page x:Class="Pharmacy.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pharmacy.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Background=" #0f172a">
            <TextBlock Background="Transparent" Foreground="gray" Margin="20,0,0,0">Справочные</TextBlock>
            <Button Background="Transparent" Foreground="white" Padding="0,0,50,0" Click="Button_Click_1" x:Name="s1">Типы</Button>
            <Button Background="Transparent" Foreground="white" Padding="0,0,20,0" Click="Button_Click" x:Name="s2">Категории</Button>
            <Button Background="Transparent" Foreground="white" Padding="35,0,0,0" Click="Button_Click_2" x:Name="s3">Еденицы измерения</Button>
            <Button Background="Transparent" Foreground="white" Padding="55,0,30,0" Click="Button_Click_3" x:Name="s4">Условия хранения</Button>
            <Button Background="Transparent" Foreground="white" Padding="0,0,15,0" Click="Button_Click_5" x:Name="s5">Препараты</Button>
            <Button Background="Transparent" Foreground="white" Padding="10,0,0,0"  Click="Button_Click_4" x:Name="s6">Производители</Button>
            <TextBlock Background="Transparent" Foreground="gray" Margin="20,0,0,0">Операции</TextBlock>
            <Button Background="Transparent" Foreground="white" Padding="0,0,5,0" Click="Button_Click_6" x:Name="s7">Поставщики</Button>
            <Button Background="Transparent" Foreground="white" Padding="0,0,15,0" Click="Button_Click_9" >Прибытия</Button>
            <TextBlock Background="Transparent" Foreground="gray" Margin="20,0,0,0">Продажи</TextBlock>
            <Button Background="Transparent" Foreground="white" Padding="0,0,5,0" Click="Button_Click_7" x:Name="s8">Покупатели</Button>
            <Button Background="Transparent" Foreground="white" Padding="0,0,5,0" Click="Button_Click_8" x:Name="s9">Сотрудники</Button>
            <Button Background="Transparent" Foreground="white" Padding="20,0,0,0" Click="Button_Click_10">История продаж</Button>

        </StackPanel>

        <Frame NavigationUIVisibility="Hidden" Source="LogInPage.xaml" Background="#355270" Grid.Column="1" x:Name="MainFrame"/>
    </Grid>
</Page>
