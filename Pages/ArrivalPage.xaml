<Page x:Class="Pharmacy.Pages.ArrivalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pharmacy.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ArrivalPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="200"></ColumnDefinition>

        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1">
            <Button Margin="7" Height="25" Click="Button_Click">
                Добавить
            </Button>
            <Button Margin="7" Height="25" Click="Button_Click_1">
                Удалить
            </Button>

        </StackPanel>
        <ListView 
                  MouseDoubleClick="ListView_MouseDoubleClick_1"
ItemsSource="{Binding service.Users}"

SelectedItem="{Binding current}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>


                        <TextBlock>
<Run Text="Препарат: "/>
<Run Text="{Binding Medicine.Name}"/>

                        </TextBlock>
                        <TextBlock>
<Run Text="Поставщик: "/>
<Run Text="{Binding Supplier.Name}"/>

                        </TextBlock>
                        <TextBlock>
<Run Text="Дата: "/>
<Run Text="{Binding Date}"/>

                        </TextBlock>
                        <TextBlock>
<Run Text="Кол-во: "/>
<Run Text="{Binding OrderNumber}"/>

                        </TextBlock>
                        <TextBlock>
<Run Text="Цена поставки: "/>
<Run Text="{Binding Price}"/>

                        </TextBlock>
                        <TextBlock>
<Run Text="Цена за упаковку: "/>
<Run Text="{Binding PricePackage}"/>

                        </TextBlock>
                        

                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
